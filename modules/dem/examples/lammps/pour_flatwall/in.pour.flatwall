# LAMMPS examples/granular/in.pour.flatwall reduced to what the module represents: one material
# everywhere (the original's floor model, hertz/material 1e5 1e3 0.3 with the default
# viscoelastic damping, Mindlin NULL 1.0 0.5, plus the type-1 rolling sds 500 200 0.5, no
# twisting) and one block insertion region in place of the two cylinders. Run with
#   lmp -in in.pour.flatwall
atom_style      sphere
units           lj
variable        boxx equal 20
variable        boxy equal 20
variable        boxz equal 30
variable        dens equal 1.0
region          boxreg block 0 ${boxx} 0 ${boxy} 0 ${boxz}
create_box      1 boxreg
change_box      all boundary p p f
pair_style      granular
pair_coeff      * * hertz/material 1e5 1e3 0.3 tangential mindlin NULL 1.0 0.5 rolling sds 500.0 200.0 0.5
comm_modify     vel yes
region          insreg block 1 19 5 15 15 30
fix             1 all nve/sphere
fix             grav all gravity 10.0 vector 0 0 -1
fix             ins all pour 3000 1 3123 region insreg diam range 0.5 1.0 dens ${dens} ${dens}
neighbor        0.15 bin
neigh_modify    delay 0 every 1 check yes
fix             3 all wall/gran granular hertz/material 1e5 1e3 0.3 tangential mindlin NULL 1.0 0.5 rolling sds 500.0 200.0 0.5 zplane 0 NULL
compute         kea all ke/atom
compute         ke all reduce sum c_kea
compute         erot all erotate/sphere
variable        zmax equal bound(all,zmax)
thermo_style    custom step atoms c_ke c_erot v_zmax
thermo_modify   lost warn norm no
thermo          100
timestep        0.001
run             5000
