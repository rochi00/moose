[Tests]
  design = 'KokkosParticleCloud.md SidesetWalls.md'
  issues = '#1'

  [floor_analytic]
    type = CSVDiff
    input = floor_analytic.i
    csvdiff = floor_analytic_out_state_0006.csv
    # The reference: the gold is this run
    rel_err = 1e-10
    requirement = 'The system shall bounce a sphere with friction on an analytic plane, as the reference for the sideset floor.'
    capabilities = 'kokkos'
  []
  [floor]
    type = CSVDiff
    input = floor.i
    csvdiff = floor_out_state_0006.csv
    # V13: identical to the analytic plane to roundoff
    rel_err = 1e-10
    requirement = 'The system shall bounce a sphere with friction on a wall made of a mesh sideset identically to the analytic plane it coincides with, on any number of ranks.'
    capabilities = 'kokkos'
  []
  [plane3d_analytic]
    type = CSVDiff
    input = plane3d_analytic.i
    csvdiff = plane3d_analytic_out_state_0004.csv
    rel_err = 1e-10
    requirement = 'The system shall bounce a sphere with friction on an analytic plane in three dimensions, as the reference for the triangulated floor.'
    capabilities = 'kokkos'
  []
  [plane3d]
    type = CSVDiff
    input = plane3d.i
    csvdiff = plane3d_out_state_0004.csv
    # V12: identical to the analytic plane to roundoff while the contact slides across triangle
    # edges and a vertex shared by eight triangles
    rel_err = 1e-10
    requirement = 'The system shall bounce a sphere with friction on a triangulated sideset floor identically to the analytic plane, with the contact sliding across triangle edges and vertices, on any number of ranks.'
    capabilities = 'kokkos'
  []
  [corner]
    type = CSVDiff
    input = corner.i
    csvdiff = corner_out_state_0008.csv
    # The collision is first order in the substep, as in the restitution tests: 1e-4 here
    rel_err = 2e-4
    requirement = 'The system shall treat the reentrant corner of a mesh, where two sideset wall faces meet in a vertex convex toward the sphere, as a single contact along the line from the vertex, so that a sphere hitting it head-on rebounds with the sphere-wall coefficient of restitution.'
    capabilities = 'kokkos'
  []
  [moving_floor]
    type = CSVDiff
    input = moving_floor.i
    csvdiff = moving_floor_out_state_0005.csv
    # V14: the sphere rides the floor to 7e-9 in velocity and 1e-12 in position. The initial
    # forces are evaluated before the floor's first velocity is known, giving a kick of one
    # substep's dashpot force that has decayed to 1e-8 by the end; the spin stays under abs_zero
    rel_err = 2e-8
    abs_zero = 1e-7
    requirement = 'The system shall carry a sphere resting on a sideset wall driven by prescribed nodal displacement variables along with the wall, the wall moving at the velocity that reaches the displacement of each step, on any number of ranks.'
    capabilities = 'kokkos'
  []
  [hopper_analytic]
    type = CSVDiff
    input = hopper_analytic.i
    csvdiff = hopper_analytic_out_state_0030.csv
    # The reference: the gold is the serial run; the bounces amplify the roundoff of the ghost
    # summation order in parallel to 4e-10 in the smallest coordinate
    rel_err = 1e-8
    abs_zero = 1e-5
    requirement = 'The system shall settle a bed of frictional spheres into a V of two analytic planes, as the reference for the mesh-defined hopper.'
    capabilities = 'kokkos'
  []
  [hopper]
    type = CSVDiff
    input = hopper.i
    csvdiff = hopper_out_state_0030.csv
    # Phase 3 exit check: the bed at rest (velocities and spins 1e-14) in the same arrangement,
    # the resting positions within 8e-6 m of the analytic-wall pile (1.2e-4 relative; the two
    # spheres on the axis of the V have x within abs_zero). Rank-independent to the same digits
    rel_err = 2e-4
    abs_zero = 1e-5
    requirement = 'The system shall settle a bed of frictional spheres in a hopper whose walls are the sidesets of a rotated mesh into the pile obtained with the equivalent analytic planes, on any number of ranks.'
    capabilities = 'kokkos'
  []
  [floor_fine_parallel]
    type = CSVDiff
    input = floor.i
    cli_args = 'Mesh/gen/nx=80 Mesh/gen/ny=40 Outputs/file_base=floor_fine_parallel_out'
    csvdiff = floor_fine_parallel_out_state_0006.csv
    # Elements of 0.005 under a sphere of radius 0.01: the wall faces a particle can reach are
    # exchanged between ranks by distance, not taken from the one-element ghost layer, so the
    # partitioning does not matter
    rel_err = 1e-10
    min_parallel = 2
    requirement = 'The system shall bounce a sphere on a sideset floor meshed finer than the sphere identically to the analytic plane on several ranks, the wall faces within reach being exchanged between ranks.'
    capabilities = 'kokkos'
  []
  [hopper_one_sideset]
    type = CSVDiff
    input = hopper.i
    cli_args = "Mesh/rename/type=RenameBoundaryGenerator Mesh/rename/input=rotate Mesh/rename/old_boundary='bottom left' Mesh/rename/new_boundary='v v' Mesh/final_generator=rename UserObjects/cloud/wall_boundaries=v Outputs/file_base=hopper_one_sideset_out"
    csvdiff = hopper_one_sideset_out_state_0030.csv
    # Both sides of the V in one sideset: the contact histories are per face, carried across the
    # coplanar faces of a side and kept apart at the 90 degree crease, so the run is bitwise the
    # same as with the sides in two sidesets on a given number of ranks (the gold is the serial
    # two-sideset run; in parallel the bounces amplify the ghost summation roundoff, as in hopper)
    rel_err = 2e-4
    abs_zero = 1e-5
    requirement = 'The system shall keep separate contact histories on the faces of one sideset that meet at a crease, so a bed settling in a V-hopper whose two sides are one sideset gives the same pile as with two.'
    capabilities = 'kokkos'
  []
[]
