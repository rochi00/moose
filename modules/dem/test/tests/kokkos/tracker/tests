[Tests]
  design = 'KokkosParticleCloud.md'
  issues = '#1'

  [walk_2d]
    type = CSVDiff
    input = walk_2d.i
    csvdiff = walk_2d_out.csv
    requirement = 'The system shall track the element containing each particle on device by walking across element faces, taking several hops per step when a particle crosses several cells, migrate particles that cross a partition boundary to the rank owning the element they reached so that the result does not depend on the number of ranks, and remove particles that leave the mesh, verified against the libMesh point locator every step.'
    capabilities = 'kokkos'
  []
  [walk_3d]
    type = CSVDiff
    input = walk_3d.i
    csvdiff = walk_3d_out.csv
    requirement = 'The system shall track, migrate, and remove particles moving in all three directions through a three-dimensional hexahedral mesh, with results independent of the number of ranks.'
    capabilities = 'kokkos'
  []
  [walk_2d_fallback]
    type = CSVDiff
    input = walk_2d.i
    cli_args = 'UserObjects/cloud/max_hops=1 Outputs/file_base=walk_2d_fallback_out'
    csvdiff = walk_2d_fallback_out.csv
    # The hop count is meaningless when the walk is hop-limited and depends on how many walks the
    # migration rounds add
    ignore_columns = 'max_hops'
    # With one hop per step the walk cannot follow the particles, so every step they are unresolved
    # until the point locator places them; the exited and particle counts match walk_2d and no
    # particle is left unresolved, which verify = true would otherwise report as an error
    requirement = 'The system shall locate a particle whose element could not be resolved within the hop budget with the point locator at the end of the step, so that the result matches an unrestricted walk.'
    capabilities = 'kokkos'
  []
[]
