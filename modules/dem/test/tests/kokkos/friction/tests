[Tests]
  design = 'KokkosParticleCloud.md Friction.md'
  issues = '#1'

  [sliding_sphere]
    type = CSVDiff
    input = sliding_sphere.i
    csvdiff = sliding_sphere_out_state_0010.csv
    # The rolling velocity and spin match to 1e-14; the position is offset by the tangential
    # spring's stretch at the stick transition, mu m g / k_t = 3e-7, so 3e-7 relative
    rel_err = 1e-6
    requirement = 'The system shall decelerate a sphere sliding on a wall with Coulomb friction at mu g while the friction torque spins it up, until it rolls without slipping at 5/7 of its launch speed, carrying the contact history with the sphere across partitions, on any number of ranks.'
    capabilities = 'kokkos'
  []
  [oblique_impact]
    type = CSVDiff
    input = oblique_impact.i
    csvdiff = oblique_impact_out_state_0006.csv
    # Serial gold; identical to roundoff on any number of ranks
    rel_err = 1e-8
    requirement = 'The system shall compute the oblique collision of two spheres with the Hertz-Mindlin model and Coulomb friction, giving both the same spin, identically on any number of ranks with the pair across a partition advancing its contact history on both.'
    capabilities = 'kokkos'
  []
  [oblique_impact_rebuild]
    type = CSVDiff
    input = oblique_impact.i
    cli_args = 'UserObjects/cloud/skin=0.002 Outputs/file_base=oblique_impact_rebuild_out'
    csvdiff = oblique_impact_rebuild_out_state_0006.csv
    # V9: the neighbor list is rebuilt 26 times instead of 5; the histories carried across
    # rebuilds give the identical result
    rel_err = 1e-8
    requirement = 'The system shall give the same result for an oblique collision with friction when a smaller neighbor-list skin makes the list, and the contact histories with it, rebuild five times as often.'
    capabilities = 'kokkos'
  []
  [oblique_impact_regroup]
    type = CSVDiff
    input = oblique_impact.i
    cli_args = 'UserObjects/cloud/substeps=250 Executioner/dt=0.0025 Executioner/num_steps=12 Outputs/file_base=oblique_impact_regroup_out'
    csvdiff = oblique_impact_regroup_out_state_0012.csv
    # The same substeps grouped into twice as many steps give the identical result: the forces
    # of the last substep, computed with the half-step velocities like every other, carry over
    # the step boundary (gold identical to oblique_impact's)
    rel_err = 1e-8
    requirement = 'The system shall give the identical trajectory when the same substeps are grouped into steps of a different size, the contact forces carrying over the step boundary as they do between substeps.'
    capabilities = 'kokkos'
  []
  [mindlin_loading]
    type = CSVDiff
    input = mindlin_loading.i
    csvdiff = 'mindlin_loading_out_state_0005.csv mindlin_loading_out_state_0010.csv'
    # V7: the force, velocity, and spin match the reference integration of the loading curve to
    # 3e-8 at both outputs, on both branches of the oscillation
    rel_err = 1e-6
    # The normal force balances gravity to roundoff and nothing moves out of the plane
    abs_zero = 1e-12
    requirement = 'The system shall, with the Hertz-Mindlin model and partial slip, apply a tangential force following the Mindlin-Deresiewicz loading curve mu P (1 - (1 - delta / delta_max)^(3/2)) of the contact point displacement under a constant normal force, verified through the oscillation of a sphere on a wall against a reference integration.'
    capabilities = 'kokkos'
  []
[]
