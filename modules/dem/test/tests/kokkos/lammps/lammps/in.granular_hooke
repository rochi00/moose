# pair granular hooke + linear_history + velocity damping with limit_damping on the compressed
# 32-sphere lattice from rest (the module's linear model with pair granular's conventions)
newton          off off
atom_modify     map array
units           lj
atom_style      sphere
comm_modify     vel yes
lattice         fcc 0.8442
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
displace_atoms  all random 0.01 0.01 0.01 623426
set group all diameter 1.25
set group all mass 1.0
velocity all set 0.0 0.0 0.0
pair_style granular
pair_coeff * * hooke 1000.0 25.0 tangential linear_history 500.0 1.0 0.02 damping velocity limit_damping
timestep 0.001
fix 1 all nve/sphere
dump 1 all custom 50 dump.granular_hooke id x y z vx vy vz omegax omegay omegaz
dump_modify 1 format float %.17g sort id
thermo 50
thermo_style custom step ke pe press
run 100
