# fix wall/gran hooke/history with two shearing zplane walls (the setting of LAMMPS's
# fix-timestep-wall_gran unit test) on a non-overlapping fcc lattice of thermal spheres, without
# normal damping (1e-9: zero makes LAMMPS produce NaN) so the normal force never turns
# attractive and the Coulomb caps agree
newton          off off
atom_modify     map array
units           lj
atom_style      sphere
boundary        p p f
comm_modify     vel yes
lattice         fcc 0.8442
region          box block 0 2 0 2 -0.5 2.5
create_box      1 box
region          atoms block 0 2 0 2 0 1.99
create_atoms    1 region atoms
set group all diameter 1.0
set group all mass 1.0
velocity all create 0.5 4534624
pair_style gran/hooke/history 1000.0 285.714285714285714 1e-9 2.5 0.5 1
pair_coeff * *
fix 1 all nve/sphere
fix 2 all wall/gran hooke/history 1000.0 285.714285714285714 1e-9 1.25 0.5 1 zplane -0.6 3.96 shear x 0.5
timestep 0.002
dump 1 all custom 50 dump.wall_gran_shear id x y z vx vy vz omegax omegay omegaz
dump_modify 1 format float %.17g sort id
thermo 50
thermo_style custom step ke pe press
run 200
