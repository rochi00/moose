# pair granular hertz/material + coeff_restitution damping + mindlin + rolling sds with
# limit_damping on the compressed 32-sphere lattice from rest. E = 4000/3 and nu = 1/3;
# xt = sqrt(2 (1 - nu) / (2 - nu)) makes the tangential dashpot the module's Tsuji form
newton          off off
atom_modify     map array
units           lj
atom_style      sphere
comm_modify     vel yes
lattice         fcc 0.8442
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
displace_atoms  all random 0.01 0.01 0.01 623426
set group all diameter 1.25
set group all mass 1.0
velocity all set 0.0 0.0 0.0
pair_style granular
pair_coeff * * hertz/material 1333.3333333333333 0.8 0.33333333333333333 tangential mindlin NULL 0.89442719099991588 0.5 rolling sds 500.0 50.0 0.1 damping coeff_restitution limit_damping
timestep 0.001
fix 1 all nve/sphere
dump 1 all custom 50 dump.granular_hertz id x y z vx vy vz omegax omegay omegaz
dump_modify 1 format float %.17g sort id
thermo 50
thermo_style custom step ke pe press
run 100
