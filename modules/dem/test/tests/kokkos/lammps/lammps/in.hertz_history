# gran/hertz/history with limit_damping on the compressed 32-sphere lattice from rest (LAMMPS's
# setup step does not advance histories, so no contact may be at the Coulomb limit at step 0).
# kt = 1200 = 6/5 kn corresponds to Poisson's ratio 1/3 in the module's Hertz-Mindlin model
newton          off off
atom_modify     map array
units           lj
atom_style      sphere
comm_modify     vel yes
lattice         fcc 0.8442
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
displace_atoms  all random 0.01 0.01 0.01 623426
set group all diameter 1.25
set group all mass 1.0
velocity all set 0.0 0.0 0.0
pair_style gran/hertz/history 1000.0 1200.0 50.0 30.0 0.5 1 limit_damping
pair_coeff * *
timestep 0.001
fix 1 all nve/sphere
dump 1 all custom 50 dump.hertz_history id x y z vx vy vz omegax omegay omegaz
dump_modify 1 format float %.17g sort id
thermo 50
thermo_style custom step ke pe press
run 100
