# fix wall/gran hooke/history: a sphere hits the floor z = 0 obliquely with spin and bounces
units lj
atom_style sphere
comm_modify vel yes
boundary f f f
region box block -3 3 -3 3 -1 3
create_box 1 box
create_atoms 1 single 0 0 0.63
set group all diameter 1.25
set group all mass 1.0
velocity all set 1.0 0.3 -2.0
set group all omega 0.0 4.0 1.0
pair_style gran/hooke/history 1000.0 500.0 50.0 50.0 0.4 1
pair_coeff * *
fix 1 all nve/sphere
fix 2 all wall/gran hooke/history 1000.0 500.0 50.0 50.0 0.4 1 zplane 0.0 NULL
timestep 0.001
dump 1 all custom 25 dump.wall_gran id x y z vx vy vz omegax omegay omegaz
dump_modify 1 format float %.17g
run 200
