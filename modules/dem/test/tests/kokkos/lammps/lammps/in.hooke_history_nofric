# gran/hooke/history on the unittest configuration (atomic-pair-gran_hooke_history.yaml) with
# slower particles so the normal force stays repulsive; positions, velocities, spins, forces,
# and torques dumped every 50 steps of 0.001 (contact time pi sqrt(m_eff / k_n) = 0.070)
newton          off off
atom_modify     map array
units           lj
atom_style      sphere
comm_modify     vel yes
lattice         fcc 0.8442
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
displace_atoms  all random 0.05 0.05 0.05 623426
set group all diameter 1.25
set group all mass 1.0
velocity all create 0.05 4534624
pair_style gran/hooke/history 1000.0 500.0 50.0 50.0 0.0 1
pair_coeff * *
timestep 0.001
fix 1 all nve/sphere
dump 1 all custom 50 dump.hooke_history_nofric id x y z vx vy vz omegax omegay omegaz fx fy fz tqx tqy tqz
dump_modify 1 format float %.17g sort id
thermo 50
thermo_style custom step ke pe press
run 100
