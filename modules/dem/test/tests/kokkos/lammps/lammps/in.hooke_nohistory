# gran/hooke (tangential dashpot without a spring) on the compressed 32-sphere lattice at low
# speed, so the normal force stays repulsive and the Coulomb cap conventions agree
newton          off off
atom_modify     map array
units           lj
atom_style      sphere
comm_modify     vel yes
lattice         fcc 0.8442
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box
displace_atoms  all random 0.01 0.01 0.01 623426
set group all diameter 1.25
set group all mass 1.0
velocity all create 0.005 4534624
pair_style gran/hooke 1000.0 NULL 50.0 50.0 0.4 1
pair_coeff * *
timestep 0.001
fix 1 all nve/sphere
dump 1 all custom 50 dump.hooke_nohistory id x y z vx vy vz omegax omegay omegaz
dump_modify 1 format float %.17g sort id
thermo 50
thermo_style custom step ke pe press
run 100
