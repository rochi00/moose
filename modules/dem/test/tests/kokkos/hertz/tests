[Tests]
  design = 'KokkosParticleCloud.md Hertz.md'
  issues = '#1'

  [stack]
    type = CSVDiff
    input = stack.i
    csvdiff = stack_out_state_0010.csv
    # The settled positions agree with the equilibrium overlaps to roundoff (1e-16 in position,
    # 1e-12 in overlap); residual velocities of 1e-13 fall under abs_zero
    rel_err = 1e-12
    requirement = 'The system shall settle two spheres stacked on a wall under gravity with the Hertz contact model to the overlaps at which the force (4/3) E* sqrt(r_eff) delta^(3/2) balances the weight above each contact, for the sphere-wall and sphere-sphere effective radii, on any number of ranks.'
    capabilities = 'kokkos'
  []
  [missing_modulus]
    type = RunException
    input = ../contact/restitution.i
    cli_args = 'UserObjects/cloud/contact_model=hertz Outputs/csv=false'
    expect_err = 'The Hertz model needs youngs_modulus and poissons_ratio'
    requirement = 'The system shall report an error when the Hertz contact model is selected without its material parameters.'
    capabilities = 'kokkos'
  []
  [stack_force]
    type = CSVDiff
    input = stack.i
    cli_args = "Postprocessors/floor/type=KokkosWallForce Postprocessors/floor/cloud=cloud Postprocessors/floor/wall=0 Postprocessors/floor/component=y Postprocessors/top/type=KokkosParticleCloudValue Postprocessors/top/cloud=cloud Postprocessors/top/value=max_y Outputs/csv=false Outputs/final/type=CSV Outputs/final/execute_on=FINAL Outputs/final/file_base=stack_force_out"
    csvdiff = stack_force_out.csv
    rel_err = 1e-10
    requirement = 'The system shall report the force the particles exert on a wall, the weight of the settled stack on the floor, and the extent of the bed, the top of the stack.'
    capabilities = 'kokkos'
  []
  [stack_profile]
    type = CSVDiff
    input = stack.i
    cli_args = "VectorPostprocessors/profile/type=KokkosParticleProfile VectorPostprocessors/profile/cloud=cloud VectorPostprocessors/profile/direction=y VectorPostprocessors/profile/num_bins=1 VectorPostprocessors/profile/execute_on=TIMESTEP_END Outputs/file_base=stack_profile_out"
    csvdiff = stack_profile_out_profile_0010.csv
    # The contact stress of the settled stack in one slab over the domain: the virial of the
    # pair contact, (2 r - delta) m g, and of the wall contact carrying both, r 2 m g, over the
    # slab area; the settled overlaps match to 1e-12 and the residual velocities are under
    # abs_zero
    rel_err = 1e-8
    abs_zero = 1e-8
    requirement = 'The system shall report the contact stress of a settled stack from the pair and wall contact virials.'
    capabilities = 'kokkos'
  []
[]
