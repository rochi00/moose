[Tests]
  design = 'KokkosParticleCloud.md'
  issues = '#1'

  [ballistic]
    type = CSVDiff
    input = ballistic.i
    csvdiff = 'ballistic_out_state_0001.csv ballistic_out_state_0002.csv ballistic_out_state_0003.csv ballistic_out_state_0004.csv ballistic_out_state_0005.csv'
    # Velocity Verlet is exact for constant acceleration; the gold is the analytic parabola from
    # generate_gold.py and the tolerance allows only roundoff over 200 substeps
    rel_err = 1e-12
    abs_zero = 1e-13
    requirement = 'The system shall integrate a particle under gravity with Velocity Verlet over substeps such that its trajectory matches the analytic parabola to roundoff.'
    capabilities = 'kokkos'
  []
  [free_rotation]
    type = CSVDiff
    input = free_rotation.i
    csvdiff = free_rotation_out.csv
    # The gold is the analytic I = 2/5 m r^2, KE_rot = I |w|^2 / 2, |L| = I |w| from generate_gold.py
    rel_err = 1e-12
    requirement = 'The system shall conserve the spin angular momentum and rotational kinetic energy of a freely rotating sphere over ten thousand substeps to roundoff.'
    capabilities = 'kokkos'
  []
[]
