[Tests]
  design = 'diffuse_interface_dam_break_algorithm.md'
  [static_droplet_laplace_pressure]
    type = CSVDiff
    input = 'static_droplet_laplace_pressure.i'
    csvdiff = 'static_droplet_laplace_pressure_csv.csv'
    heavy = true
    requirement = 'The system shall reproduce the Young-Laplace pressure jump across a static '
                  'diffuse interface to within 0.3% when the interface width is resolved by four '
                  'cells and the step is iterated to convergence, hold the volume fraction within '
                  'its physical bounds, and keep the parasitic velocity small, using the '
                  'conservative diffuse-interface volume-of-fluid formulation.'
    max_threads = 1 # see libmesh issue #3808
  []
  [static_droplet_laplace_pressure_rz]
    type = CSVDiff
    input = 'static_droplet_laplace_pressure_rz.i'
    csvdiff = 'static_droplet_laplace_pressure_rz_csv.csv'
    heavy = true
    requirement = 'The system shall reproduce the Young-Laplace pressure jump across a static '
                  'spherical diffuse interface in axisymmetric coordinates to within 0.3% when the '
                  'interface width is resolved by four cells and the step is iterated to '
                  'convergence, hold the volume fraction within its physical bounds, and keep the '
                  'parasitic velocity small, using the conservative diffuse-interface '
                  'volume-of-fluid formulation.'
    max_threads = 1 # see libmesh issue #3808
  []
  [vof_advection]
    type = CSVDiff
    input = 'vof_advection.i'
    csvdiff = 'vof_advection_csv.csv'
    requirement = 'The system shall translate a volume fraction slab at the prescribed uniform '
                  'velocity of a single-density flow, conserving its integral and advancing its '
                  'first moment at the analytic rate, with results independent of the mesh '
                  'partitioning.'
    # With three processes a partition boundary lies one cell ahead of the slab front, where the
    # bounded correction is limited, so a partition-dependent limiter changes the result.
    min_parallel = 3
    max_threads = 1 # see libmesh issue #3808
  []
  [uniform_temperature_advection]
    type = CSVDiff
    input = 'uniform_temperature_advection.i'
    csvdiff = 'uniform_temperature_advection_csv.csv'
    requirement = 'The system shall keep a uniform temperature uniform while transporting the '
                  'conserved mixture enthalpy across a moving diffuse interface between phases '
                  'whose enthalpies differ and depend nonlinearly on temperature, and conserve the '
                  'total enthalpy.'
    max_threads = 1 # see libmesh issue #3808
  []
  [two_layer_conduction]
    type = CSVDiff
    input = 'two_layer_conduction.i'
    csvdiff = 'two_layer_conduction_csv.csv'
    # Once converged, the pure-cell error is rounding of ~1e-10 K on a 100 K span that moves with
    # the partitioning; the 1e-7 K floor asserts it stays there
    override_columns = 'max_pure_cell_T_error'
    override_rel_err = '5.5e-6'
    override_abs_zero = '1e-7'
    requirement = 'The system shall reproduce the sharp-interface steady temperature outside a '
                  'diffuse interface for conduction through a liquid layer under a gas layer with '
                  'a different conductivity, between walls held at fixed temperatures, when the '
                  'conserved mixture enthalpy is solved with temperature-dependent heat '
                  'capacities.'
    max_threads = 1 # see libmesh issue #3808
  []
  [differentially_heated_cavity]
    type = CSVDiff
    input = 'differentially_heated_cavity.i'
    csvdiff = 'differentially_heated_cavity_csv.csv'
    requirement = 'The system shall reproduce the average Nusselt number of the de Vahl Davis '
                  'differentially heated cavity at a Rayleigh number of 1e3 to within 1.2% on a '
                  '32 x 32 mesh, with the buoyancy entering through a Boussinesq density and the '
                  'reduced pressure pinned in the closed cavity.'
    max_threads = 1 # see libmesh issue #3808
  []
  [hydrostatic_interface]
    type = CSVDiff
    input = 'hydrostatic_interface.i'
    csvdiff = 'hydrostatic_interface_csv.csv'
    # The spurious velocity is the residue of cancelling buoyancy against the pressure gradient.
    # It never rises above the 5e-3 floor asserted here (it is ~1e-6 throughout), and the floor
    # itself is rounding that moves between compilers and partitionings. Bounds and conservation
    # keep tight tolerances of their own.
    rel_err = 0.1
    abs_zero = 5e-3
    override_columns = 'total_alpha alpha_min alpha_max interface_measure'
    override_rel_err = '1e-10 1e-8 1e-8 1e-8'
    override_abs_zero = '1e-12 1e-12 1e-12 1e-8'
    requirement = 'The system shall hold a flat horizontal interface between two fluids at rest '
                  'under gravity, so that the reduced-pressure coupling cancels the buoyancy '
                  'source, the volume fraction stays bounded and conserved, and the spurious '
                  'velocity stays at its residual floor.'
    max_threads = 1 # see libmesh issue #3808
  []
  [oil_water_tub]
    type = CSVDiff
    input = 'oil_water_tub.i'
    csvdiff = 'oil_water_tub_csv.csv'
    # The velocities, the heat fluxes and the minimum reduced pressure are rounding, ~1e-8 and
    # below, that moves between compilers and partitionings; the 1e-6 floor asserts they stay
    # there. The rest keep tight tolerances of their own.
    rel_err = 0.1
    abs_zero = 1e-6
    override_columns = 'total_alpha interface_measure max_p T_min T_max max_pure_cell_T_error'
    override_rel_err = '1e-10 1e-8 1e-6 1e-10 1e-10 1e-10'
    override_abs_zero = '1e-12 1e-12 1e-10 1e-10 1e-10 1e-9'
    requirement = 'The system shall hold a layer of oil over a layer of water at rest and at '
                  'uniform temperature in a closed tub with the conserved mixture enthalpy and a '
                  'Boussinesq buoyancy density coupled to the flow, keeping the reduced pressure '
                  'jump across the diffuse interface, the volume fraction conserved, and the '
                  'spurious velocity at its residual floor.'
    max_threads = 1 # see libmesh issue #3808
  []
  [stefan]
    requirement = 'The system shall melt a semi-infinite solid from a hot wall with the latent heat '
                  'carried by the conserved mixture enthalpy, and reproduce the exact similarity '
                  'solution'
    design = 'ConservativeDiffuseInterfaceMixtureEnthalpy.md'
    # One-dimensional runs of about a second on 200 cells, too small for parallel or restart runs
    max_parallel = 1
    recover = false
    [three_region]
      type = CSVDiff
      input = 'stefan_three_region.i'
      csvdiff = 'stefan_three_region_csv.csv'
      detail = 'with a linear liquid fraction over a finite melting interval, against the '
               'three-region solution of Kondrashov, to an L2 temperature error of 5e-4 and a '
               'melted depth within 0.4% on 100 cells; and'
      max_threads = 1 # see libmesh issue #3808
    []
    [neumann]
      type = CSVDiff
      input = 'stefan_neumann.i'
      csvdiff = 'stefan_neumann_csv.csv'
      detail = 'with melting at a single temperature, against the two-phase Neumann solution, to '
               'an L2 temperature error of 2.4e-3 and a melted depth within 0.2% on 100 cells; and'
      max_threads = 1 # see libmesh issue #3808
    []
    [solid_properties]
      type = CSVDiff
      input = 'stefan_solid_properties.i'
      csvdiff = 'stefan_solid_properties_csv.csv'
      detail = 'with a solid of its own heat capacity and conductivity, given by separate fluid '
               'properties with a different enthalpy reference, against the two-phase Neumann '
               'solution with a solid diffusivity four times the liquid one.'
      max_threads = 1 # see libmesh issue #3808
    []
  []
  [freezing_film]
    type = CSVDiff
    input = 'freezing_film.i'
    csvdiff = 'freezing_film_csv.csv'
    requirement = 'The system shall freeze a film of water under air from a cold wall with ice '
                  'less dense than water, the expanding ice pushing the water and the air above '
                  'it out of the domain, and reproduce the ice front of the similarity solution '
                  'with density change of Lyu et al. to within 1.7% on 200 cells, the expelled '
                  'water volume exactly and the volume fraction bounds, with the ice held at rest '
                  'by a penalty and the volume source of the freezing added in the input.'
    design = 'ConservativeDiffuseInterfaceMixtureEnthalpy.md'
    # A one-dimensional run of about fifteen seconds on 400 cells
    max_parallel = 1
    recover = false
    max_threads = 1 # see libmesh issue #3808
  []
[]
