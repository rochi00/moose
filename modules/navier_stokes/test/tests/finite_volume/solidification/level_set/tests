    prereq = material_advection_amr_affine
    requirement = 'The geometry-aware linear finite-volume material-advection reconstruction '
                  'shall preserve an affine field when flow crosses a static 2:1 AMR interface '
                  'from fine cells into a coarse cell.'
    max_threads = 1
  []

  [mass_conserved_translation]
