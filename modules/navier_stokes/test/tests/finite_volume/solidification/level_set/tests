[Tests]
  [quadratic_semi_lagrangian]
    type = CSVDiff
    input = quadratic_semi_lagrangian.i
    csvdiff = quadratic_semi_lagrangian.csv
    requirement = 'The quadratic semi-Lagrangian linear-FV operator shall exactly translate a '
                  'quadratic field under a constant velocity in one time step.'
    max_threads = 1
  []

  [quadratic_semi_lagrangian_distributed]
    type = CSVDiff
    input = quadratic_semi_lagrangian.i
    csvdiff = quadratic_semi_lagrangian.csv
    cli_args = 'Mesh/parallel_type=distributed'
    prereq = quadratic_semi_lagrangian
    min_parallel = 2
    max_parallel = 2
    max_threads = 1
    requirement = 'The quadratic semi-Lagrangian reconstruction shall produce the same result '
                  'when its departure-point patches cross MPI partitions.'
  []

  [material_advection_constant]
