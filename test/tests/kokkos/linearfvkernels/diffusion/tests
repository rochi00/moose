[Tests]
  design = 'KokkosLinearFVDiffusion.md'
  issues = '#30655'
  [mms-kokkos-diffusion-2d-orthogonal]
    requirement = 'The system shall be able to solve an orthogonal two-dimensional diffusion problem with a linear finite volume discretization using Kokkos for process-local parallel dispatch'
    [dirichlet_only]
      type = MMSTest
      input = 'test.py'
      test_case = TestKokkosLinearFVDiffusion2DOrthogonal
      detail = 'with only Dirichlet boundary conditions or'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda xpu'
      max_threads = 1
    []
    [mixed_dirichlet_neumann]
      type = MMSTest
      input = 'test.py'
      test_case = TestKokkosLinearFVDiffusion2DOrthogonalNeumann
      detail = 'with mixed Dirichlet and Neumann boundary conditions.'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda xpu'
      max_threads = 1
    []
    [internal_neumann_block_restricted]
      type = MMSTest
      input = 'test.py'
      test_case = TestKokkosLinearFVDiffusion2DInternalNeumann
      detail = 'with Neumann boundary conditions on internal boundaries of two block-restricted variables.'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda xpu'
      max_threads = 1
    []
  []
  [matches-host-linearfv]
    type = Exodiff
    input = 'match-non-kokkos.i'
    exodiff = 'diffusion-1d-aux_out.e'
    gold_dir = '../../../variables/linearfv/gold'
    requirement = 'The system shall produce the same linear finite volume diffusion solution using Kokkos process-local parallel dispatch as the host implementation.'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda xpu'
    max_threads = 1
  []
  [matches-host-linearfv-gather]
    type = Exodiff
    input = 'match-non-kokkos.i'
    exodiff = 'diffusion-1d-aux_out.e'
    gold_dir = '../../../variables/linearfv/gold'
    cli_args = 'Problem/kokkos_linear_fv_assembly=gather'
    prereq = 'matches-host-linearfv'
    requirement = 'The system shall produce the same linear finite volume diffusion solution as the host implementation when the Kokkos face contributions are stored per face and summed per cell in a fixed order.'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda xpu'
    max_threads = 1
  []
  [rz]
    type = MMSTest
    input = 'test.py'
    test_case = TestKokkosLinearFVDiffusion1DRZ
    requirement = 'The system shall account for cylindrical coordinate factors in Kokkos linear finite volume element volumes and face areas.'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda xpu'
    max_threads = 1
  []
  [rspherical]
    type = MMSTest
    input = 'test.py'
    test_case = TestKokkosLinearFVDiffusion1DRSpherical
    requirement = 'The system shall account for spherical coordinate factors in Kokkos linear finite volume element volumes and face areas.'
    capabilities = 'kokkos'
    compute_devices = 'cpu cuda xpu'
    max_threads = 1
    min_slots = 2
  []
  [kokkos_threads]
    type = MMSTest
    input = 'test.py'
    test_case = TestKokkosLinearFVDiffusion2DOrthogonalNeumannKokkosThreads
    requirement = 'The system shall dispatch Kokkos linear finite volume kernels and boundary conditions with multiple host backend threads, set independently of the MOOSE thread count, and retain second-order convergence for a two-dimensional diffusion problem with mixed Dirichlet and Neumann boundary conditions.'
    capabilities = 'kokkos'
    compute_devices = 'cpu'
    max_threads = 1
  []
  [device_petsc_types]
    requirement = 'The system shall keep the matrix and vectors of a linear system assembled only by Kokkos objects in device memory on GPU builds'
    [default]
      type = RunApp
      input = 'kokkos_diffusion-2d.i'
      cli_args = 'Mesh/gmg/nx=4 Mesh/gmg/ny=4 -ksp_view'
      expect_out = "Linear system 'u_sys' is assembled by Kokkos objects only; keeping its matrix and vectors in device memory.*type: (seq|mpi)aijkokkos"
      detail = 'by default, and'
      capabilities = 'kokkos'
      compute_devices = 'cuda xpu'
      max_threads = 1
    []
    [user_types]
      type = RunApp
      input = 'kokkos_diffusion-2d.i'
      cli_args = 'Mesh/gmg/nx=4 Mesh/gmg/ny=4 -vec_type standard -u_sys_mat_type aij'
      absent_out = 'keeping its matrix and vectors in device memory'
      detail = 'not when the input or the command line selects other PETSc types.'
      capabilities = 'kokkos'
      compute_devices = 'cuda xpu'
      max_threads = 1
    []
  []
[]
