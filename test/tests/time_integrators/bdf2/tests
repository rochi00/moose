[Tests]
  design = 'BDF2.md'
  issues = '#1953'

  [group]
    requirement = "The system shall support the second-order backward difference method for time integration"
    [./test]
      type = 'Exodiff'
      input = 'bdf2.i'
      exodiff = 'bdf2_out.e'

      detail = "with and"
    [../]

    [./adapt]
      type = 'Exodiff'
      input = 'bdf2_adapt.i'
      exodiff = 'bdf2_adapt_out.e-s005'
      group = 'adaptive'

      detail = "without mesh adaptivity."
    [../]
  []

  [fv]
    requirement = 'The system shall be able to show second order temporal accuracy using the BDF2 time integration scheme with a finite volume'
    [nonlinear]
      detail = 'nonlinear implementation, and'
      type = MMSTest
      input = test.py
      test_case = TestNonlinearFV
    []
    [linear]
      detail = 'linear implementation.'
      type = MMSTest
      input = test.py
      test_case = TestLinearFV
    []
  []

  [history_restart]
    type = CSVDiff
    input = restart.i
    csvdiff = restart_out.csv
    requirement = 'The BDF2 integrator shall discard history across a prescribed temporal '
                  'discontinuity and restart with an implicit one-step formula.'
    max_parallel = 1
  []

  [history_restart_linearfv]
    type = CSVDiff
    input = restart-linearfv.i
    csvdiff = restart-linearfv_out.csv
    prereq = history_restart
    requirement = 'The Linear FV BDF2 matrix and right-hand-side weights shall use the same '
                  'implicit history restart across a prescribed temporal discontinuity.'
    max_parallel = 1
  []
[]
